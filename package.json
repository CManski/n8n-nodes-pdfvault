{
  "name": "n8n-nodes-pdfvault",
  "version": "1.0.0",
  "description": "n8n community node for PDF Vault — privacy-first PDF toolkit API with 13 PDF operations, AI processing, eSign, QR codes, URL shortener, templates, webhooks, teams, workspaces, and comments.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "pdf",
    "pdfvault",
    "merge",
    "split",
    "compress",
    "watermark",
    "ai",
    "esign",
    "electronic-signature",
    "qr-code",
    "url-shortener",
    "template",
    "webhook",
    "team",
    "workspace",
    "comments"
  ],
  "license": "MIT",
  "homepage": "https://pdfvault.app",
  "author": {
    "name": "PDF Vault",
    "email": "support@pdfvault.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CManski/n8n-nodes-pdfvault"
  },
  "main": "dist/nodes/PdfVault/PdfVault.node.js",
  "scripts": {
    "build": "node node_modules/typescript/lib/tsc.js && cp nodes/PdfVault/pdfvault.svg dist/nodes/PdfVault/ && cp nodes/PdfVault/PdfVault.node.json dist/nodes/PdfVault/",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodeTypes": [
      "dist/nodes/PdfVault/PdfVault.node.js"
    ],
    "credentials": [
      "dist/credentials/PdfVaultApi.credentials.js"
    ]
  },
  "dependencies": {
    "n8n-workflow": "^1.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
